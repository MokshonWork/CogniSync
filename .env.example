# Cognisync - Environment Variables
#
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` with real secrets. `.env` is gitignored.

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
# Get an API key at https://openrouter.ai/ and add credits if using paid models.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional chairman override; the default is the first free fallback model.
# Council members come from the live free-model catalog (GET /api/models).
# CHAIRMAN_MODEL=deepseek/deepseek-chat-v3.1:free

# ---------------------------------------------------------------------------
# Free-testing mode (strict: council uses only catalog-verified free models)
# ---------------------------------------------------------------------------
# When true (default), the council only uses models the OpenRouter catalog
# reports as free (zero prompt/completion pricing, preferably ':free' ids).
# Requests for paid models are rejected instead of silently billed.
FREE_TESTING_MODE=true

# How many council members to assemble from the free catalog (default 4).
# COUNCIL_MODEL_COUNT=4

# How long (seconds) the OpenRouter model catalog is cached server-side.
# POST /api/models/refresh always forces a re-fetch.
# MODEL_CATALOG_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# PostgreSQL (Neon) — REQUIRED in production
# ---------------------------------------------------------------------------
# Reads exclusively from the environment. Never hardcode a connection string.
# For Neon, append ?sslmode=require to the connection string.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# When unset, the backend falls back to a local SQLite file for development.
# (Production deployments refuse to start without DATABASE_URL.)
DATABASE_URL=

# ---------------------------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------------------------
# Signing secret for JWT access tokens. REQUIRED in production — the backend
# refuses to start if this is missing while running on Render
# (RENDER=1) or with COGNISYNC_ENV=production. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNISYNC_JWT_SECRET=change-me-in-production

# Access token lifetime in minutes (default 60). Logout revokes the token's
# JTI server-side; revoked entries are cleaned once the token would have
# expired.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT issuer and audience claims (default "cognisync" / "cognisync-api").
JWT_ISSUER=cognisync
JWT_AUDIENCE=cognisync-api

# ---------------------------------------------------------------------------
# GitHub integration (direct official REST API — read-only)
# ---------------------------------------------------------------------------
# Personal access token with repo read scope. Without a token, public
# repositories are readable at reduced rate limits. Never exposed to the
# frontend or logs.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Notion integration (direct official Notion API — read-only)
# ---------------------------------------------------------------------------
# Internal integration token (secret_...). Pages must be shared with the
# integration in Notion. Never exposed to the frontend or logs.
NOTION_TOKEN=

# ---------------------------------------------------------------------------
# Request / rate-limit policy (OpenRouter)
# ---------------------------------------------------------------------------
# Maximum concurrent OpenRouter requests (default 5).
# OPENROUTER_MAX_CONCURRENCY=5

# Total attempts per request, including the first (default 3).
# RATE_LIMIT_MAX_ATTEMPTS=3

# Exponential backoff cap in seconds (default 30).
# RATE_LIMIT_BACKOFF_CAP_SECONDS=30

# Whole-request retry budget in seconds (default 90).
# RATE_LIMIT_TOTAL_TIMEOUT=90

# ---------------------------------------------------------------------------
# Web search (DuckDuckGo via the `ddgs` library — no API key required)
# ---------------------------------------------------------------------------
# Optional tuning:
# DDG_MAX_RESULTS=8
# DDG_TIMEOUT=20

# Upload limits are server-side constants (10 MB per file, 5 attachments)
# in backend/upload_validation.py; they are not environment variables.
